    %% Cameras produce frames. SimCamera renders its own view at fps of sim time,
    %% staggered by offset; all cameras share one offscreen renderer per scene.
    class Camera{
        <<interface>>
        is_available()*$ bool
        connect() void
        read()* Frame
        close() void
    }
    class SimCamera{
    }
    Camera <|-- SimCamera
    class Frame{
        camera_name str
        rgb uint8_HxWx3
        depth uint16_or_none
    }

    %% The simulation owns physics only. One step() is one control tick.
    class Simulation{
        step(action) void
        reset() void
        state ndarray
    }
    SimCamera --> Simulation : renders a view of

